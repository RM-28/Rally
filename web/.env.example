# Board settings. Copy to web/.env.local for local dev. In Amplify set the same names under
# App settings > Environment variables; amplify.yml bakes them into the build.
# Everything here is public: NEXT_PUBLIC_* values end up in the browser. Never put secrets here.

# the engine (FastAPI). Required on Amplify, e.g. https://1-2-3-4.sslip.io; defaults to localhost locally
NEXT_PUBLIC_API_URL=http://localhost:8000

# public address of the board for the phone QR code; empty = whatever address the browser is on
NEXT_PUBLIC_BOARD_URL=

# Luminal price in $ per 1M tokens for the Usage card's cost; empty = viewers can type a rate
NEXT_PUBLIC_LUMINAL_PRICE_PER_M=

# who you are in Rally until there is sign-in (a seeded person id)
# NEXT_PUBLIC_RALLY_USER=maya   # left unset it falls back to "test"; an empty value would not
