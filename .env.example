# Engine settings (FastAPI + run loop). Copy to .env at the repo root; on EC2 it lives at app/.env.
# The board's own settings are in web/.env.example (Next.js reads env files from web/, not from here).

# --- model ---
LUMINAL_API_KEY=
LUMINAL_BASE_URL=            # from the Luminal dashboard
LUMINAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# --- database ---
MONGODB_URI=
MONGODB_DB=botteam

# --- where strategies run ---
AWS_REGION=us-east-1
LAMBDA_FUNCTION_NAME=botteam-runner
LAMBDA_MAX_CONCURRENCY=10     # Lambda calls in flight; keep at or under the account limit (aws lambda get-account-settings)
RUNNER=local                 # local | lambda
TIME_LIMIT_S=2.0             # seconds a strategy may think per instance
REPEATS=3                    # runs per strategy per instance
CHILD_MEMORY_MB=1024         # memory cap per strategy process (Linux only; CPU is capped at 3x TIME_LIMIT_S + 5s)
N_BOTS=4                     # 4 while building, 8 for the real run

# --- web access ---
# every origin the board is served from, comma separated (CORS). In production add the Amplify URL:
# WEB_ORIGIN=https://main.<app-id>.amplifyapp.com,http://localhost:3000
WEB_ORIGIN=http://localhost:3000
ADMIN_TOKEN=                 # open the board with ?admin=<token> to start, pause and stop runs

# --- Rally ---
RALLY_TZ=America/Los_Angeles # studio time for Rally routines and agent prompts
